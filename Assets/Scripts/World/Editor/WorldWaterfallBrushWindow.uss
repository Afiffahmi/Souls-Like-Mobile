.waterfall-panel { padding: 14px; flex-grow: 1; }
.waterfall-title { font-size: 19px; -unity-font-style: bold; color: rgb(115, 228, 232); margin-bottom: 6px; }
.waterfall-note { white-space: normal; margin-bottom: 9px; }
.waterfall-section { margin-top: 15px; margin-bottom: 7px; -unity-font-style: bold; }
.waterfall-panel Button { min-height: 27px; margin-top: 5px; }
.waterfall-panel Toggle { margin-top: 12px; margin-bottom: 12px; -unity-font-style: bold; }
.waterfall-panel Slider { margin-top: 4px; margin-bottom: 4px; }
.waterfall-panel HelpBox { margin-top: 8px; margin-bottom: 8px; }
