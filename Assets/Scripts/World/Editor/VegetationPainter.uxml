<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements">
  <ui:Style src="VegetationPainter.uss" />
  <ui:ScrollView class="paint-panel">
    <ui:Label text="Tree props &amp; living grass" class="title" />
    <ui:Label text="Choose a tree model or grass style, then paint in Scene view. Existing strokes keep their chosen style." class="description" />
    <editor:ObjectField name="palette" label="Palette" />
    <ui:EnumField name="mode" label="Paint" />
    <ui:DropdownField name="variation" label="Brush style" />
    <editor:ObjectField name="style-model" label="Selected model" />
    <ui:Label name="style-details" class="description" />
    <ui:Button name="edit-style" text="Edit selected style" />
    <ui:Foldout text="Add a tree or grass model" value="false" class="style-tools">
      <editor:ObjectField name="custom-model" label="Prefab" />
      <ui:TextField name="custom-name" label="Style name" />
      <ui:Button name="add-model" text="Add prefab as brush style" />
    </ui:Foldout>
    <ui:Foldout name="grass-colours" text="Create a grass colour" value="false" class="style-tools">
      <ui:TextField name="colour-name" label="New style name" />
      <editor:ColorField name="root-colour" label="Roots" />
      <editor:ColorField name="tip-colour" label="Tips" />
      <editor:ColorField name="patch-colour" label="Colour patches" />
      <ui:Button name="add-colour" text="Save colour as new grass style" />
    </ui:Foldout>
    <ui:Slider name="radius" label="Brush radius (m)" low-value="1" high-value="30" show-input-field="true" />
    <ui:Slider name="density" label="Density" low-value="0.05" high-value="1" show-input-field="true" />
    <ui:Toggle name="paint" label="Enable painting" />
    <ui:Toggle name="erase" label="Erase mode" />
    <ui:Label text="Drag: paint · Shift + drag: erase · Ctrl/Cmd + Z: Undo · Alt: orbit camera" class="description" />
    <ui:Label text="Style assets control model, height, spacing and grass colour. This vegetation brush is separate from terrain and road painting. Red brush areas mark invalid ground or steep slopes." class="description" />
    <ui:Button name="frame" text="Frame starting area" />
    <ui:Button name="save" text="Save painted chunks" class="save" />
    <ui:Label name="status" class="status" />
  </ui:ScrollView>
</ui:UXML>
