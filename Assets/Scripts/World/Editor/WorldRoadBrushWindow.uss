.road-panel { padding: 14px; }
.road-title { font-size: 19px; -unity-font-style: bold; margin-bottom: 5px; }
.road-note { white-space: normal; margin-bottom: 12px; }
.road-section { margin-top: 12px; margin-bottom: 6px; -unity-font-style: bold; }
.road-panel Button { margin-top: 5px; min-height: 27px; }
.road-panel Toggle { margin-top: 10px; margin-bottom: 10px; }
.road-panel HelpBox { margin-top: 10px; }
.road-panel .paint-enabled { color: rgb(136, 218, 162); -unity-font-style: bold; }
.road-preview { height: 128px; margin-top: 8px; margin-bottom: 8px; }
