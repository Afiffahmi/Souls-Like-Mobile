.world-panel { padding: 16px; }
.world-title { font-size: 22px; -unity-font-style: bold; margin-bottom: 4px; }
.world-subtitle { font-size: 14px; margin-bottom: 16px; }
.world-heading { font-size: 16px; -unity-font-style: bold; margin-top: 20px; margin-bottom: 8px; }
.world-note { white-space: normal; margin-bottom: 12px; }
.world-panel Button { margin-top: 6px; min-height: 28px; }
.world-status { white-space: normal; margin-top: 16px; padding: 12px; background-color: rgb(32, 48, 44); color: rgb(218, 236, 224); }
