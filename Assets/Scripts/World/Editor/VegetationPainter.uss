.paint-panel { padding: 12px; }
.title { font-size: 17px; -unity-font-style: bold; margin-bottom: 8px; }
.description { white-space: normal; margin-top: 8px; margin-bottom: 12px; color: rgb(196,207,201); }
.save { height: 30px; margin-top: 8px; background-color: rgb(42,91,66); color: white; }
.status { white-space: normal; margin-top: 12px; padding: 10px; background-color: rgb(37,42,40); color: rgb(219,231,224); }
